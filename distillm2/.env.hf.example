# Copy to .env.hf and set a token if the repository/model is private or gated.
HF_TOKEN=
HF_HOME=.hf_cache

# GPU selection. The train scripts infer NUM_PROCESSES from this list.
RUN_GPUS=0,1

# Llama 8B -> 1B DistiLLM-2 defaults.
LLAMA_PROCESSED_ROOT=../processed_data/spider_data/llama
LLAMA_STUDENT_MODEL=meta-llama/Llama-3.2-1B-Instruct

# Set this to the Llama 1B Spider SFT checkpoint when available.
# Examples:
# LLAMA_STUDENT_CKPT_PATH=../results/llama/<llama-1b-sft-run>/1090
# LLAMA_STUDENT_CKPT_PATH=hf://your-org/your-repo/path/to/llama-1b-sft/1090
LLAMA_STUDENT_CKPT_PATH=
LLAMA_STUDENT_IS_LORA=auto

LLAMA_TEACHER_BASE=meta-llama/Llama-3.1-8B-Instruct
LLAMA_TEACHER_LORA=hf://distillation-sql/llama_spider/llama/sft_sft_llama3_8b_lora_spider_lm_e5-bs2-lr0.0001-G8-N2-NN1-lora-16-64-0.1/e5-bs2-lr0.0001-G8-N2-NN1-lora-16-64-0.1/1090

LLAMA_PAIR_DATA_DIR=data/spider_sql_distillm2_llama
LLAMA_TEACHER_TRAIN_RESULTS=infer_results/llama_teacher_train.json
LLAMA_TEACHER_VALID_RESULTS=infer_results/llama_teacher_valid.json
LLAMA_STUDENT_TRAIN_RESULTS=infer_results/llama_student_train.json
LLAMA_STUDENT_VALID_RESULTS=infer_results/llama_student_valid.json
LLAMA_OUTPUT_DIR=outputs/llama3.2-1b-8b-spider-distillm2
LLAMA_HUB_MODEL_ID=distillation-sql/llama_spider

# Generation and training controls.
LLAMA_GENERATION_BATCH_SIZE=4
KD_LOSS_WEIGHT=1.0
RESUME=1
REBUILD_INFERENCE=0
REBUILD_PAIRS=0

# Optional upload of the new DistiLLM-2 checkpoint.
PUSH_TO_HUB=false
