# Copy to .env.hf and set a token if the repository is private.
HF_TOKEN=
HF_HOME=.hf_cache

# GPU selection. The train scripts infer NUM_PROCESSES from this list.
RUN_GPUS=0,1

# Batch sizes for Spider generation/evaluation scripts.
GENERATION_BATCH_SIZE=100
BATCH_SIZE=16

# Existing Spider SFT checkpoint uploaded under distillation-sql/baselines.
STUDENT_MODEL=Qwen/Qwen3-0.6B
STUDENT_CKPT_PATH=hf://distillation-sql/baselines/qwen3/sft_sft_qwen3_0.6b_spider/e5-bs4-lr5e-05-G4-N2-NN1/1090

# Existing teacher base and LoRA adapter.
TEACHER_BASE=Qwen/Qwen3-4B-Instruct-2507
TEACHER_LORA=hf://distillation-sql/baselines/qwen3/sft_sft_qwen3_4b_spider_lora/e5-bs4-lr0.0001-G4-N2-NN1-lora-32-64-0.1/1090

# Local training output.
OUTPUT_DIR=outputs/qwen3-0.6b-4b-spider-distillm2

# Optional upload of the new DistiLLM-2 checkpoint.
PUSH_TO_HUB=false
HUB_MODEL_ID=distillation-sql/qwen3-0.6b-spider-distillm2

# Llama 8B -> 1B DistiLLM-2 overrides. These are intentionally LLAMA_*
# variables so a Qwen default above does not leak into the Llama runner.
LLAMA_PROCESSED_ROOT=../processed_data/spider_data/llama
LLAMA_STUDENT_MODEL=meta-llama/Llama-3.2-1B-Instruct
# Set this to a local/HF Llama 1B Spider SFT checkpoint if you have one.
LLAMA_STUDENT_CKPT_PATH=
LLAMA_TEACHER_BASE=meta-llama/Llama-3.1-8B-Instruct
LLAMA_TEACHER_LORA=hf://distillation-sql/llama_spider/llama/sft_sft_llama3_8b_lora_spider_lm_e5-bs2-lr0.0001-G8-N2-NN1-lora-16-64-0.1/e5-bs2-lr0.0001-G8-N2-NN1-lora-16-64-0.1/1090
LLAMA_OUTPUT_DIR=outputs/llama3.2-1b-8b-spider-distillm2
LLAMA_HUB_MODEL_ID=distillation-sql/llama3.2-1b-8b-spider-distillm2
